# development | production (production enforces a master key, https webhooks, disables open sign-up)
SANGAM_ENV=production
# Public URL of this server (checkout links, invoice links, gateway redirect and webhook URLs)
SANGAM_BASE_URL=https://pay.example.com
SANGAM_DATABASE_URL=postgresql+psycopg://sangam:sangam@db:5432/sangam
# 32 random bytes, base64. Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Keep it in a secrets manager. Losing it makes stored bank details and gateway credentials unrecoverable.
SANGAM_MASTER_KEY=
# Comma-separated old keys still needed to decrypt during rotation
SANGAM_PREVIOUS_MASTER_KEYS=
# Allow POST /v1/merchants without auth (set true briefly to create your first merchant)
SANGAM_ALLOW_SIGNUP=false
# Run webhook + billing loops in the API process (docker-compose runs a separate worker instead)
SANGAM_RUN_WORKERS=true
# Trust X-Forwarded-For (only behind your own reverse proxy)
SANGAM_TRUST_PROXY=true
# Multiply the default rate limits (100 burst / 25 per second per API key)
SANGAM_RATE_LIMIT_SCALE=1
